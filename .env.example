# Copy to .env for local dev. On Fly.io set these with `fly secrets set`.
MODEL_API_KEY=put-your-key-here
META_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
WONDER_MODEL=muse-wonder-1.0
SAM_MODEL=sam-3.1
# Required on any public URL. Local dev can leave it empty.
ACCESS_CODE=pick-a-password
API_PORT=8791
DATA_DIR=./data
DAILY_SPEND_LIMIT_USD=10
# Lifetime model budget of each "Try TrueScene" guest workspace.
GUEST_SPEND_LIMIT_USD=1
